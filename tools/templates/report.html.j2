{%- macro t(obj) -%}<span lang="en">{{ obj.en }}</span><span lang="bg">{{ obj.bg }}</span>{%- endmacro -%}
{%- macro L(key) -%}<span lang="en">{{ labels[key].en }}</span><span lang="bg">{{ labels[key].bg }}</span>{%- endmacro -%}
{%- macro story_card(s, n) -%}
<article class="story" id="{{ s.story_id }}">
  <div class="story-meta">
    <span class="num">{{ "%02d" % n }}</span>
    <span class="chip">{{ L("cat_" ~ s.category) }}</span>
    <span class="imp" title="importance {{ s.importance }}/5">{% for i in range(5) %}<i class="{{ 'on' if i < s.importance }}"></i>{% endfor %}</span>
    {% set outlets = s.sources | map(attribute='outlet') | unique | list %}
    <span class="count">{{ outlets | length }} {{ L("outlets" if outlets | length != 1 else "outlet") }}</span>
  </div>
  <h3>{{ t(s.title) }}</h3>
  <p class="summary">{{ t(s.summary) }}</p>
  <ul class="facts">
    {% for f in s.key_facts %}<li>{{ t(f) }}</li>{% endfor %}
  </ul>
  {% if s.coverage_comparison %}
  <details class="compare" open>
    <summary>{{ L("how_covered") }}</summary>
    <p class="overview">{{ t(s.coverage_comparison.overview) }}</p>
    {% for d in s.coverage_comparison.differences %}
    <div class="diff">
      <span class="aspect a-{{ d.aspect }}">{{ L("asp_" ~ d.aspect) }}</span>
      <span class="who">{{ d.outlets | join(" · ") }}</span>
      <p>{{ t(d.point) }}</p>
    </div>
    {% endfor %}
  </details>
  {% endif %}
  <div class="sources">
    <div class="sources-label">{{ L("sources") }}</div>
    <ul>
      {% for src in s.sources %}
      <li><span class="outlet">{{ src.outlet }}</span>
        <a href="{{ src.url }}" target="_blank" rel="noopener" title="{{ src.headline_original }}">{{ t(src.headline) }}</a></li>
      {% endfor %}
    </ul>
  </div>
</article>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>News Review {{ report.date }}</title>
<style>
  :root {
    --bg: #f7f5f0; --paper: #ffffff; --ink: #1c1b19; --muted: #6b675f; --rule: #e3dfd6;
    --accent: #b3261e; --accent-soft: #f6e3e1; --chip: #efece5; --link: #1d4f91;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #131312; --paper: #1c1c1a; --ink: #ecebe7; --muted: #a29e95; --rule: #34332f;
      --accent: #ff8a80; --accent-soft: #3a2422; --chip: #2a2926; --link: #8ab4f8;
    }
  }
  * { box-sizing: border-box; }
  /* Language switch is pure CSS (radio + :has) so it works even where scripts are blocked. */
  html:has(#lang-bg:checked) [lang="en"], html:not(:has(#lang-bg:checked)) [lang="bg"] { display: none; }
  .lang input { position: absolute; opacity: 0; pointer-events: none; }
  body { margin: 0; background: var(--bg); color: var(--ink);
    font: 17px/1.55 Georgia, "Times New Roman", serif; }
  .wrap { max-width: 860px; margin: 0 auto; padding: 0 16px; }
  header.top { border-bottom: 3px double var(--ink); padding: 28px 0 14px; }
  .masthead { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  h1 { font-size: clamp(28px, 6vw, 44px); line-height: 1.05; margin: 0; letter-spacing: -0.5px; }
  .dateline { font: 14px/1.4 system-ui, sans-serif; color: var(--muted); margin-top: 8px; }
  .lang { display: inline-flex; border: 1px solid var(--ink); border-radius: 999px; overflow: hidden;
    font: 600 13px system-ui, sans-serif; flex-shrink: 0; margin-left: auto; position: relative; }
  .lang label { color: var(--ink); padding: 6px 14px; cursor: pointer; user-select: none; }
  .lang input:checked + label { background: var(--ink); color: var(--bg); }
  .lang input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: -2px; }
  nav.sections { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 18px; font: 600 14px system-ui, sans-serif; padding: 10px 0;
    border-bottom: 1px solid var(--rule); position: sticky; top: 0; background: var(--bg); z-index: 2; }
  nav.sections a { color: var(--ink); text-decoration: none; }
  nav.sections a:hover { color: var(--accent); }
  h2.section { font: 800 13px system-ui, sans-serif; letter-spacing: 2px; text-transform: uppercase;
    color: var(--accent); margin: 36px 0 12px; padding-bottom: 6px; border-bottom: 2px solid var(--accent); }
  .story { background: var(--paper); border: 1px solid var(--rule); border-radius: 6px; padding: 20px 22px; margin: 0 0 18px; }
  .story-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font: 12px system-ui, sans-serif; color: var(--muted); }
  .num { font-weight: 800; color: var(--ink); }
  .chip { background: var(--chip); padding: 2px 8px; border-radius: 3px; text-transform: uppercase; letter-spacing: .5px; }
  .imp i { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--rule); margin-right: 2px; }
  .imp i.on { background: var(--accent); }
  .count { margin-left: auto; font-weight: 600; }
  .story h3 { font-size: 23px; line-height: 1.25; margin: 10px 0 8px; }
  .summary { margin: 0 0 10px; }
  .facts { margin: 0 0 12px; padding-left: 20px; font-size: 15.5px; }
  .facts li { margin: 3px 0; }
  details.compare { background: var(--accent-soft); border-radius: 5px; padding: 10px 14px; margin: 12px 0; }
  details.compare summary { cursor: pointer; font: 700 14px system-ui, sans-serif; color: var(--accent); }
  .overview { font-style: italic; margin: 8px 0; }
  .diff { border-top: 1px solid var(--rule); padding: 8px 0 2px; }
  .diff p { margin: 4px 0 0; font-size: 15.5px; }
  .aspect { font: 700 11px system-ui, sans-serif; text-transform: uppercase; letter-spacing: .5px; color: var(--accent); }
  .who { font: 600 12px system-ui, sans-serif; color: var(--muted); margin-left: 6px; }
  .sources-label { font: 700 11px system-ui, sans-serif; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin: 6px 0 4px; }
  .sources ul { list-style: none; margin: 0; padding: 0; font-size: 14.5px; }
  .sources li { padding: 3px 0; overflow-wrap: anywhere; }
  .outlet { font: 700 12px system-ui, sans-serif; display: inline-block; min-width: 92px; color: var(--ink); }
  .sources a { color: var(--link); text-decoration: none; }
  .sources a:hover { text-decoration: underline; }
  table.outlets { width: 100%; border-collapse: collapse; font: 14px system-ui, sans-serif; background: var(--paper); }
  table.outlets td, table.outlets th { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--rule); }
  table.outlets td.n { text-align: right; font-variant-numeric: tabular-nums; }
  .zero { color: var(--accent); }
  footer { font: 13px/1.5 system-ui, sans-serif; color: var(--muted); padding: 28px 0 48px; }
  footer a { color: var(--link); }
  @media (max-width: 560px) {
    body { font-size: 16px; }
    .story { padding: 16px 14px; }
    .story h3 { font-size: 20px; }
    .outlet { display: block; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="masthead">
      <div>
        <h1>{{ L("title") }}</h1>
        <div class="dateline">{{ t(date_long) }} · {{ report.stats.articles_scanned }} {{ L("articles_from") }} {{ report.stats.outlets }} {{ L("outlets") }} · {{ report.stats.compared }} {{ L("compared") }}</div>
      </div>
    </div>
  </header>
  <nav class="sections">
    <a href="#world">{{ L("world") }}</a>
    <a href="#bulgaria">{{ L("bulgaria") }}</a>
    <a href="#sources">{{ L("sources") }}</a>
    <a href="{{ archive_href }}">{{ L("archive") }}</a>
    <div class="lang" role="radiogroup" aria-label="Language">
      <input type="radio" name="lang" id="lang-en" value="en" checked><label for="lang-en">EN</label><input type="radio" name="lang" id="lang-bg" value="bg"><label for="lang-bg">BG</label>
    </div>
  </nav>

  <h2 class="section" id="world">{{ L("world") }}</h2>
  {% for s in report.world %}{{ story_card(s, loop.index) }}{% endfor %}

  <h2 class="section" id="bulgaria">{{ L("bulgaria") }}</h2>
  {% for s in report.bulgaria %}{{ story_card(s, loop.index) }}{% endfor %}

  <h2 class="section" id="sources">{{ L("sources_scanned") }}</h2>
  <table class="outlets">
    <tr><th>{{ L("outlet") }}</th><th>{{ L("region") }}</th><th>{{ L("ownership") }}</th><th>{{ L("articles") }}</th></tr>
    {% for o in report.outlets %}
    <tr><td>{{ o.name }}</td><td>{{ L("world" if o.region == "world" else "bulgaria") }}</td>
      <td>{{ L("own_" ~ o.ownership) }}</td><td class="n {{ 'zero' if not o.articles_scanned }}">{{ o.articles_scanned }}</td></tr>
    {% endfor %}
  </table>

  <footer>{{ L("method") }}<br>{{ L("generated") }} {{ report.generated_at }}</footer>
</div>
<script>
  // Optional: remember the chosen language. The switch itself needs no script.
  (function () {
    var saved = null;
    try { saved = localStorage.getItem("lang"); } catch (e) {}
    if (saved === "bg" || saved === "en") document.getElementById("lang-" + saved).checked = true;
    document.documentElement.lang = document.getElementById("lang-bg").checked ? "bg" : "en";
    document.querySelectorAll(".lang input").forEach(function (r) {
      r.addEventListener("change", function () {
        document.documentElement.lang = r.value;
        try { localStorage.setItem("lang", r.value); } catch (e) {}
      });
    });
  })();
</script>
</body>
</html>
