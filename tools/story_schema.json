{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "bi": {
      "type": "object",
      "required": ["en", "bg"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "bg": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "required": ["story_id", "section", "importance", "category", "title", "summary", "key_facts", "sources", "coverage_comparison"],
  "properties": {
    "story_id": {"type": "string", "pattern": "^[wb][0-9]{2}$"},
    "section": {"enum": ["world", "bulgaria"]},
    "importance": {"type": "integer", "minimum": 1, "maximum": 5},
    "category": {"enum": ["politics", "conflict", "diplomacy", "economy", "justice", "society", "environment", "disaster", "health", "science_tech"]},
    "title": {"$ref": "#/$defs/bi"},
    "summary": {"$ref": "#/$defs/bi"},
    "key_facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bi"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["outlet", "url", "headline_original", "headline"],
        "properties": {
          "outlet": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "headline_original": {"type": "string"},
          "headline": {"$ref": "#/$defs/bi"}
        }
      }
    },
    "coverage_comparison": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["overview", "differences"],
          "properties": {
            "overview": {"$ref": "#/$defs/bi"},
            "differences": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["aspect", "outlets", "point"],
                "properties": {
                  "aspect": {"enum": ["framing", "emphasis", "omission", "tone", "sources_quoted", "context", "facts"]},
                  "outlets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                  "point": {"$ref": "#/$defs/bi"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
